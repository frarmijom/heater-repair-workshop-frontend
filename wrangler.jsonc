{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heater-repair-workshop-frontend",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/api-proxy.mjs"
}
